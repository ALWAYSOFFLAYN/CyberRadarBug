INI
# /etc/systemd/system/newsbot.service

[Unit]
Description=Telegram News Bot
After=network.target

[Service]
User=YOUR_USERNAME
WorkingDirectory=/path/to/telegram-news-bot
ExecStart=/path/to/telegram-news-bot/venv/bin/python bot.py
Restart=on-failure

[Install]
WantedBy=multi-user.target

